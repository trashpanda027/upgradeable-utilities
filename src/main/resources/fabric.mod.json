{
	"schemaVersion": 1,
	"id": "upgradeable-utilities",
	"version": "${version}",
	"name": "Upgradeable Utilities",
	"description": "A mod that adds upgradeability to different utility blocks!",
	"authors": [
		"rabidraccoon027"
	],
	"contact": {
		"homepage": "https://discord.gg/dgp9bHMbZ6",
		"sources": "https://github.com/trashpanda027/upgradeable-utilities"
	},
	"license": "CC0-1.0",
	"icon": "assets/upgradeable-utilities/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"rabid.uputils.UpgradeableUtilities"
		],
		"fabric-datagen": [
			"rabid.uputils.UpgradeableUtilitiesDataGenerator"
		]
	},
	"mixins": [
		"upgradeable-utilities.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
